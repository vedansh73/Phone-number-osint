<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Phone Number Info</title>
<style>
  :root {
    --bg: #f3f6f4; --card: #ffffff; --text: #17211c; --muted: #5d6b64;
    --line: #d5dfd9; --accent: #1b6b4a; --bad: #b3261e;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #101613; --card: #18211c; --text: #e6efe9; --muted: #93a39a;
            --line: #2a372f; --accent: #5fd39c; --bad: #ff8a80; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 24px 16px; background: var(--bg); color: var(--text);
         font-family: system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.5; }
  main { max-width: 520px; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 4px; }
  p.sub { margin: 0 0 20px; color: var(--muted); }
  .row { display: flex; gap: 8px; }
  input { flex: 1; min-width: 0; padding: 12px; font-size: 1rem; border: 1px solid var(--line);
          border-radius: 8px; background: var(--card); color: var(--text); }
  button { padding: 12px 18px; font-size: 1rem; border: 0; border-radius: 8px;
           background: var(--accent); color: var(--bg); font-weight: 600; cursor: pointer; }
  input:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #result { margin-top: 20px; background: var(--card); border: 1px solid var(--line);
            border-radius: 8px; overflow: hidden; }
  #result:empty { display: none; }
  dl { margin: 0; }
  .item { display: flex; justify-content: space-between; gap: 12px; padding: 10px 14px;
          border-bottom: 1px solid var(--line); }
  .item:last-child { border-bottom: 0; }
  dt { color: var(--muted); }
  dd { margin: 0; text-align: right; word-break: break-all; }
  .err { padding: 14px; color: var(--bad); }
  .note { margin-top: 20px; font-size: .85rem; color: var(--muted); }
</style>
</head>
<body>
<main>
  <h1>Phone Number Info</h1>
  <p class="sub">Technical details only: country, type, format, timezone. Include the country code.</p>

  <div class="row">
    <input id="num" type="tel" placeholder="+91 98765 43210" autocomplete="off">
    <button id="go">Check</button>
  </div>

  <div id="result" aria-live="polite"></div>

  <p class="note">This tool does not identify the owner of a number. Everything runs in your browser; nothing is sent anywhere.</p>
</main>

<script type="module">
import { parsePhoneNumberFromString } from "https://cdn.jsdelivr.net/npm/libphonenumber-js@1.11.18/max/+esm";

// Timezones by country (extend as needed)
const TZ = {
  IN: "Asia/Kolkata", PK: "Asia/Karachi", BD: "Asia/Dhaka", NP: "Asia/Kathmandu",
  LK: "Asia/Colombo", AE: "Asia/Dubai", SA: "Asia/Riyadh", GB: "Europe/London",
  DE: "Europe/Berlin", FR: "Europe/Paris", SG: "Asia/Singapore", JP: "Asia/Tokyo",
  AU: "Australia/Sydney (varies by state)", US: "Multiple (UTC-5 to UTC-10)",
  CA: "Multiple (UTC-3.5 to UTC-8)", RU: "Multiple (UTC+2 to UTC+12)"
};

const TYPE_NAMES = {
  MOBILE: "Mobile", FIXED_LINE: "Landline", FIXED_LINE_OR_MOBILE: "Landline or mobile",
  TOLL_FREE: "Toll free", PREMIUM_RATE: "Premium rate", SHARED_COST: "Shared cost",
  VOIP: "VoIP", PERSONAL_NUMBER: "Personal number", PAGER: "Pager", UAN: "UAN", VOICEMAIL: "Voicemail"
};

const flag = cc => [...cc].map(c => String.fromCodePoint(127397 + c.charCodeAt(0))).join("");
const out = document.getElementById("result");

function row(k, v) {
  const d = document.createElement("div"); d.className = "item";
  const dt = document.createElement("dt"); dt.textContent = k;
  const dd = document.createElement("dd"); dd.textContent = v;
  d.append(dt, dd);
  return d;
}

function check() {
  out.textContent = "";
  const input = document.getElementById("num").value.trim();
  const p = parsePhoneNumberFromString(input);

  if (!p) {
    const e = document.createElement("div"); e.className = "err";
    e.textContent = "Couldn't read this number. Start with + and the country code, like +91.";
    out.append(e); return;
  }

  let countryName = "Unknown";
  if (p.country) {
    try { countryName = new Intl.DisplayNames(["en"], { type: "region" }).of(p.country); }
    catch { countryName = p.country; }
  }
  const type = p.getType();
  const dl = document.createElement("dl");

  dl.append(
    row("Valid number", p.isValid() ? "Yes" : "No"),
    row("Possible length", p.isPossible() ? "Yes" : "No"),
    row("Country", p.country ? `${flag(p.country)} ${countryName} (${p.country})` : "Unknown"),
    row("Country code", "+" + p.countryCallingCode),
    row("Line type", type ? (TYPE_NAMES[type] || type) : "Unknown"),
    row("National number", p.nationalNumber),
    row("International", p.formatInternational()),
    row("National format", p.formatNational()),
    row("E.164", p.number),
    row("Link format", p.getURI()),
    row("Timezone", TZ[p.country] || "Not in list")
  );
  out.append(dl);
}

document.getElementById("go").addEventListener("click", check);
document.getElementById("num").addEventListener("keydown", e => { if (e.key === "Enter") check(); });
</script>
</body>
</html>
